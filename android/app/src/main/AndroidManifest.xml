<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Attendance"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.HomeActivity" />
        <activity android:name=".ui.HistoryActivity" />
        <activity android:name=".ui.SummaryActivity" />
        <activity android:name=".ui.LeavesActivity" />
        <activity android:name=".ui.HolidaysActivity" />
        <activity android:name=".ui.AdminHomeActivity" />
        <activity android:name=".ui.AdminEmployeesActivity" />
        <activity android:name=".ui.AdminAttendanceActivity" />
        <activity android:name=".ui.AdminLeavesActivity" />
        <activity android:name=".ui.AdminReportsActivity" />
    </application>
</manifest>
